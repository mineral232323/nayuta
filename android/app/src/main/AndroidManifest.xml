<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      IME 本体に加えて、動作確認用の入力画面（TestInputActivity）を持つ。
      実機テストはこの画面で行い、メッセージアプリなど個人情報を含む
      アプリをテストに使わない。
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/NayutaImeTheme"
        tools:ignore="DataExtractionRules">
        <!--
          allowBackup=false は Android 12+ で非推奨だが、入力内容を端末外に出さない
          という設計原則（docs/design.md §3-4）のため意図的に無効化している。
          バックアップ自体を切っているので dataExtractionRules は不要。
        -->

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/NayutaActivityTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TestInputActivity"
            android:exported="true"
            android:label="@string/test_input_title"
            android:theme="@style/NayutaActivityTheme"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".NayutaImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">

            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
