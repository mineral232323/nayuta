# リリース署名鍵の設定（テンプレート）
#
# 使い方:
#   cp android/keystore.properties.example android/keystore.properties
#   # 下の CHANGE_ME を実際のパスワードに置き換える
#
# android/keystore.properties は .gitignore 済み。絶対にコミットしないこと。
# CI ではファイルの代わりに NAYUTA_STORE_FILE / NAYUTA_STORE_PASSWORD /
# NAYUTA_KEY_ALIAS / NAYUTA_KEY_PASSWORD を環境変数で渡せる（環境変数が優先）。
#
# storeFile は android/ からの相対パスで解決される。
storeFile=../.cache/nayuta-release.p12
storePassword=CHANGE_ME
keyAlias=nayuta
keyPassword=CHANGE_ME
