<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      IME の窓は全面をカスタム View が塗るので、テーマ側は装飾なし・背景透明で
      十分。Material.Light を親にしておくとポップアップ等の標準配色が使える。
    -->
    <style name="NayutaImeTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/nayuta_accent</item>
    </style>

    <!--
      設定画面・テスト入力画面などの Activity 用テーマ。
      IME 用のテーマは背景透明なので、そのまま Activity に使うと
      ダーク時に「黒背景に黒文字」になって読めなくなる。Activity は
      不透明な背景を持つテーマを当てる。
    -->
    <style name="NayutaActivityTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#0B57D0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D3E3FD</item>
        <item name="colorOnPrimaryContainer">#041E49</item>
        <item name="android:windowBackground">#FCFCFF</item>
        <item name="colorSurface">#FCFCFF</item>
        <item name="colorOnSurface">#1B1C1E</item>
        <item name="colorSurfaceVariant">#E1E2EC</item>
        <item name="colorOnSurfaceVariant">#44474F</item>
        <item name="colorOutline">#74777F</item>
        <item name="colorOutlineVariant">#C4C6D0</item>
    </style>
</resources>
